# Local builds read this file through Just. Keep IMAGE_NAME in sync with the
# GitHub workflows and the installer configuration.
IMAGE_NAME="g-os"

# Replace CHANGE_ME with the GitHub user or organization that will publish the
# image. It is deliberately not a guessed identity.
REPO_ORGANIZATION="rynnoo4903"

IMAGE_DESC="A focused, approachable Linux desktop for speedrunning"
IMAGE_KEYWORDS="speedrunning,gaming,bootc,atomic,kde,linux"
IMAGE_LOGO_URL=""
DEFAULT_TAG="latest"
# Privileged helpers must use reviewed immutable digests. Update these only in a
# dedicated dependency change followed by a disk/VM smoke test.
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder@sha256:2b52843ea2bfda73b0a08d97e76b734393b1d3a804681b9fabb26723bd3a2f0b"
QEMU_IMAGE="docker.io/qemux/qemu@sha256:a91dc8f2e55d2e59a25ea959d1e3dbd5d13c85ca76fa67954ab17c58e87d76f4"
